{
  "name": "paynora-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PayNora Global Financial & Money Movement Platform Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:web": "npm run build --workspace=apps/web",
    "build:admin": "npm run build --workspace=apps/admin",
    "test:web": "npm run test --workspace=apps/web",
    "test:contracts": "node packages/api-contracts/test.js"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
